# Credentials for `npm run deploy:stage|prod`.
# Copy to scripts/.deploy.env (git-ignored) and fill in. Never commit real values.
# Variables already exported in the shell take precedence over this file.

# Chrome Web Store API (OAuth client + refresh token of the account owning both items)
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
# Developer Dashboard > Publisher > Settings
CWS_PUBLISHER_ID=
# Item IDs of the two store listings
CWS_EXTENSION_ID_STAGE=
CWS_EXTENSION_ID_PROD=

# AWS: optional named profile (otherwise the usual AWS_* variables / default profile)
# AWS_PROFILE=
